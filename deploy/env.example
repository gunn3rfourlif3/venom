# Xnith deployment environment.
#
# Copy to deploy/.env on the server, fill in, and chmod 600. Never commit
# the filled-in version: .env is gitignored and must stay that way.
#
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env

# ---------------------------------------------------------------- database
# Generate once and keep. The db container reads POSTGRES_PASSWORD; the app
# reads the whole URL, and the two must agree.
#
#   openssl rand -base64 36 | tr -d /=+ | cut -c1-40
POSTGRES_PASSWORD=
# The host is `db` — the service name on the internal network, not localhost.
DATABASE_URL=postgres://xnith:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/xnith

# ----------------------------------------------------------------- runtime
NODE_ENV=production
API_PORT=8080

# --------------------------------------------------- WhatsApp (placeholder)
# Left empty on purpose until the Meta Business Manager setup is done.
#
# Empty is the SAFE state, not a broken one: the webhook's signature check
# fails closed, so every request to /api/whatsapp/webhook is refused with a
# 401 while these are blank. Nothing can be injected in the meantime.
#
# Filling them in later needs only `docker compose up -d app` — no rebuild.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------------- IEC results
# The results API credentials, still outstanding. The GIS register that
# sources:register reads needs none of these, so the national geography
# loads without them.
IEC_USERNAME=
IEC_PASSWORD=
IEC_BASE_URL=
IEC_API_VERSION=
IEC_CONCURRENCY=4

# ------------------------------------------------------------------- scope
VENOM_PROVINCE=
VENOM_OUR_PARTY=
VENOM_RIVAL_PARTY=
VENOM_OUR_PARTY_IDS=
VENOM_RIVAL_PARTY_IDS=
VENOM_LGE_BALLOT=PR
