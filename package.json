{
  "name": "venom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file=.env dist/cli/migrate.js",
    "seed": "node --env-file=.env dist/cli/seed.js",
    "ingest:baseline": "node --env-file=.env dist/cli/ingest-baseline.js",
    "promote": "node --env-file=.env dist/cli/promote.js",
    "verify:promotion": "node --env-file=.env dist/cli/verify-promotion.js",
    "api": "node --env-file=.env dist/api/server.js",
    "create-user": "node --env-file=.env dist/cli/create-user.js",
    "sources:official": "node --env-file=.env dist/cli/sources-official.js",
    "sources:cameras": "node --env-file=.env dist/cli/sources-cameras.js",
    "sources:news": "node --env-file=.env dist/cli/sources-news.js",
    "sources:press": "node --env-file=.env dist/cli/sources-press.js",
    "sources:instagram": "node --env-file=.env dist/cli/sources-instagram.js"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "typescript": "5.7.2"
  }
}
