# IEC API credentials. Request from webmaster@elections.org.za.
# Only the ingestion CLI needs these. The API, the dashboard and
# create-user all run without them.
IEC_USERNAME=
IEC_PASSWORD=
IEC_BASE_URL=https://api.elections.org.za
IEC_API_VERSION=v1

# Concurrent in-flight requests. The Gauteng VD sweep is a few thousand
# calls; raising this past single digits risks being throttled.
IEC_CONCURRENCY=4

DATABASE_URL=postgres://postgres@localhost:5432/venom

# Scope
VENOM_PROVINCE=Gauteng
# Party identification. Pipe-separated EXACT aliases, matched against the
# abbreviation and the full name. Never substring-matched: "DEMOCRATIC
# ALLIANCE" contains "ANC" and "AFRICAN NATIONAL CONGRESS" does not.
# Prefer the numeric IEC party IDs once you know them - they are the only
# fully reliable key, and LGE results carry no abbreviation at all.
VENOM_OUR_PARTY=MK|UMKHONTO WESIZWE|UMKHONTO WESIZWE PARTY
VENOM_RIVAL_PARTY=ANC|AFRICAN NATIONAL CONGRESS
VENOM_OUR_PARTY_IDS=
VENOM_RIVAL_PARTY_IDS=

# Which LGE ballot measures party support. PR is the proportional ballot and
# is the right comparison against a national party vote; WARD is the
# candidate ballot, which independents and local names distort.
VENOM_LGE_BALLOT=PR

# --- WhatsApp Business Platform (Cloud API) -------------------------------
# Automated ingest of marshal reports. Without these the webhook refuses
# every request: the HMAC check fails closed, by design.
#
# From Meta: App Dashboard -> WhatsApp -> Configuration / API Setup.
# The App Secret is under Settings -> Basic.
WHATSAPP_APP_SECRET=
# A string you invent. Meta echoes it back during the webhook handshake.
WHATSAPP_VERIFY_TOKEN=
# Optional: only needed to acknowledge reports back to the marshal.
# Ingest works without these; marshals just get no confirmation.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
